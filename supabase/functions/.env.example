# Copy to supabase/functions/.env (git-ignored) before `supabase functions serve`.
POSTMARK_WEBHOOK_USER=testuser
POSTMARK_WEBHOOK_PASSWORD=testpwd
VITE_INBOUND_EMAIL=
# Comma-separated IPs allowed to call the Postmark webhook.
POSTMARK_WEBHOOK_AUTHORIZED_IPS=

SB_JWT_ISSUER=http://127.0.0.1:54321/auth/v1
SB_PUBLISHABLE_KEY=

# Clerk webhook endpoint signing secret. In production set it with
# `npx supabase secrets set CLERK_WEBHOOK_SECRET=...` instead of this file.
CLERK_WEBHOOK_SECRET=YOUR_CLERK_WEBHOOK_SECRET

# Public URL of the CRM app.
CRM_BASE_URL=http://localhost:5173
